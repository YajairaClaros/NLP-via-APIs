# --- Secrets: the API token must never be committed ---
.env
.env.*
!.env.example

# --- Model weights and checkpoints stay out of git (shared through Google Drive) ---
models/*
!models/.gitkeep
checkpoints/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# --- Tunnel binaries and downloads (installed on the laptop, never part of the repo) ---
ngrok.exe
ngrok.zip
cloudflared.exe
*.msi
*.zip

# --- Python / tooling ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
hf_cache/
*.log

# --- Editors and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
